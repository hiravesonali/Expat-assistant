<mxfile host="app.diagrams.net">
  <diagram id="ankommen-system" name="Ankommen system design">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Groups (drawn first so they sit behind the boxes) -->
        <mxCell id="grpOnline" value="ONLINE: every question" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="20" y="150" width="1520" height="330" as="geometry" />
        </mxCell>
        <mxCell id="grpOffline" value="OFFLINE: build the index (run locally, shipped to the app as a versioned bundle)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="20" y="520" width="1520" height="180" as="geometry" />
        </mxCell>

        <!-- Shared services -->
        <mxCell id="openrouter" value="&lt;b&gt;OpenRouter&lt;/b&gt;&lt;br&gt;GPT-4.1-mini · Qwen3 embeddings · Whisper · TTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="610" y="40" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="langsmith" value="&lt;b&gt;LangSmith&lt;/b&gt;&lt;br&gt;tracing + evaluation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1000" y="40" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- Online flow -->
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;types or speaks&lt;br&gt;(English / Deutsch)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;Streamlit app&lt;/b&gt;&lt;br&gt;chat, profile, voice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="205" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="safety" value="&lt;b&gt;Safety check&lt;/b&gt;&lt;br&gt;sensitive topics?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="190" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="analysis" value="&lt;b&gt;Query analysis&lt;/b&gt;&lt;br&gt;EN/DE rewrites, city, filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="610" y="205" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="retrieval" value="&lt;b&gt;Hybrid search&lt;/b&gt;&lt;br&gt;vectors + BM25, fused (RRF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="205" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Answer agent&lt;/b&gt;&lt;br&gt;GPT-4.1-mini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="990" y="205" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cite" value="&lt;b&gt;Citation check&lt;/b&gt;&lt;br&gt;every claim has a source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1180" y="205" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;Answer&lt;/b&gt;&lt;br&gt;with sources and steps,&lt;br&gt;read aloud on request" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1365" y="200" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="referral" value="&lt;b&gt;Fixed referral&lt;/b&gt;&lt;br&gt;lawyer, doctor, 116117 ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="370" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tools" value="&lt;b&gt;Tools&lt;/b&gt; (tested Python)&lt;br&gt;notice periods, deadlines,&lt;br&gt;benefits, checklists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="975" y="365" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- Offline flow -->
        <mxCell id="sources" value="&lt;b&gt;78 official sources&lt;/b&gt;&lt;br&gt;laws + government sites" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="580" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ingest" value="&lt;b&gt;Ingestion&lt;/b&gt;&lt;br&gt;parse, chunk by §,&lt;br&gt;add metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="610" y="585" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="index" value="&lt;b&gt;Index&lt;/b&gt;&lt;br&gt;Chroma + BM25 + parent store" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="575" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Rules file&lt;/b&gt;&lt;br&gt;amounts and limits (2026.yaml)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="990" y="580" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#334155;" edge="1" parent="1" source="user" target="ui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#334155;" edge="1" parent="1" source="ui" target="safety"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="ok" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#334155;fontSize=12;" edge="1" parent="1" source="safety" target="analysis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="sensitive" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#DC2626;fontSize=12;" edge="1" parent="1" source="safety" target="referral"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#334155;" edge="1" parent="1" source="analysis" target="retrieval"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#334155;" edge="1" parent="1" source="retrieval" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="calls when it&lt;br&gt;must calculate" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;endArrow=block;strokeColor=#EA580C;fontSize=12;" edge="1" parent="1" source="agent" target="tools"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#334155;" edge="1" parent="1" source="agent" target="cite"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#334155;" edge="1" parent="1" source="cite" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0284C7;" edge="1" parent="1" source="sources" target="ingest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0284C7;" edge="1" parent="1" source="ingest" target="index"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="search" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0284C7;fontSize=12;" edge="1" parent="1" source="index" target="retrieval"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#EA580C;" edge="1" parent="1" source="rules" target="tools"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="LLM calls" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#94A3B8;fontSize=11;fontColor=#64748B;" edge="1" parent="1" source="analysis" target="openrouter"><mxGeometry relative="1" as="geometry" /></mxCell>
