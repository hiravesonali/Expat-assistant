# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Model roles (see ADR-0006). Pick models whose endpoints support tools + structured_outputs.
MODEL_ANALYSIS=openai/gpt-4.1-mini
MODEL_ANSWER=openai/gpt-4.1-mini
MODEL_JUDGE=anthropic/claude-sonnet-4.5
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Voice (ADR-0011): speech-to-text for spoken questions, text-to-speech for the Listen button
MODEL_STT=openai/gpt-4o-mini-transcribe
MODEL_TTS=google/gemini-3.8-flash-lite-tts
TTS_VOICE=Kore

# LangSmith (EU region)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=expat-assistant
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Deployed index (ADR-0010): private Hugging Face dataset repo; `uv run expat-index --publish` uploads to it
INDEX_REPO=your-hf-name/expat-index
HF_TOKEN=hf_...
