# Copy to .streamlit/secrets.toml for local use (git-ignored), or paste into
# Community Cloud: your app -> Settings -> Secrets. Root-level keys are also copied into
# os.environ by app/pipeline_adapter.py, because expat.config reads environment variables.

# Required for Live mode (without it the app runs in Demo mode).
OPENROUTER_API_KEY = "sk-or-..."

# Optional model overrides (ADR-0006)
# MODEL_ANALYSIS = "openai/gpt-4.1-mini"
# MODEL_ANSWER = "openai/gpt-4.1-mini"
# EMBEDDING_MODEL = "qwen/qwen3-embedding-8b"

# Protects the admin pages (Retrieval Debugger, Collection Browser, Evals, Ingestion Status).
# Leave it unset locally to keep them open.
ADMIN_PASSWORD = "change-me"

# LangSmith tracing (EU region). For a public demo, consider hiding inputs/outputs.
# LANGSMITH_TRACING = "true"
# LANGSMITH_API_KEY = "lsv2_..."
# LANGSMITH_PROJECT = "expat-assistant"
# LANGSMITH_ENDPOINT = "https://eu.api.smith.langchain.com"

# Deployed index (ADR-0010): downloaded once at startup from a private Hugging Face dataset repo
INDEX_REPO = "your-hf-name/expat-index"
HF_TOKEN = "hf_..."  # a READ-only token is enough for the app
# INDEX_REVISION = "<commit sha>"  # optional: pin a version of the index
